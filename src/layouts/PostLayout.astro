---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  type: string;
}

const { title, description, pubDate, tags = [], type } = Astro.props;
---

<Layout title={`${title} | ${type}`}>
  <article class="post">
    <nav class="back-nav mono">
        <a href="/">← Return to overview</a>
        <span class="nav-socials">
          <a href="https://github.com/binit" target="_blank">[GitHub]</a>
          <a href="https://linkedin.com/in/binit" target="_blank">[LinkedIn]</a>
        </span>
      </nav>

    <header class="post-header">
      <div class="meta mono">
        <span class="type">[{type.toUpperCase()}]</span>
        <time>{pubDate.toISOString().slice(0, 10)}</time>
      </div>
      <h1>{title}</h1>
      <p class="description">{description}</p>
      
      {tags.length > 0 && (
        <div class="tags mono">
          {tags.map((tag) => <span class="tag">#{tag}</span>)}
        </div>
      )}
    </header>

    <hr class="divider" />

    <div class="markdown-content">
      <slot />
    </div>
  </article>
</Layout>

<style>
  .back-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    font-size: 0.85rem;
  }

  .nav-socials {
    display: flex;
    gap: 0.5rem;
  }

  .post-header {
    margin-bottom: 1.5rem;
  }

  .meta {
    font-size: 0.8rem;
    color: var(--text-muted);
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .type {
    color: var(--accent);
  }

  h1 {
    font-size: 1.8rem;
    color: #fff;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  .description {
    color: var(--text-muted);
    font-size: 1rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--accent-green);
    background: rgba(63, 185, 80, 0.1);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  .divider {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 1.5rem 0 2rem 0;
  }

  /* Standard Markdown typography styling */
  .markdown-content :global(h2) {
    font-size: 1.3rem;
    margin: 2rem 0 0.75rem 0;
    color: #fff;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.3rem;
  }

  .markdown-content :global(h3) {
    font-size: 1.1rem;
    margin: 1.5rem 0 0.5rem 0;
    color: #fff;
  }

  .markdown-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .markdown-content :global(ul), .markdown-content :global(ol) {
    margin: 0 0 1.25rem 1.5rem;
  }

  .markdown-content :global(li) {
    margin-bottom: 0.3rem;
  }

  .markdown-content :global(pre) {
    padding: 1rem;
    border-radius: 6px;
    border: 1px solid var(--border);
    margin: 1.25rem 0;
    overflow-x: auto;
  }

  .markdown-content :global(code) {
    background: var(--card-bg);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    font-size: 0.875em;
  }

  .markdown-content :global(pre code) {
    background: transparent;
    padding: 0;
  }

  .markdown-content :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    color: var(--text-muted);
    margin: 1.25rem 0;
  }
</style>